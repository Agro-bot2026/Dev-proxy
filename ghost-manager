    total=$(echo "$lineas" | wc -l)
    ips=$(echo "$lineas" | sed -E 's/.*::ffff:([0-9.]+).*/\1/' | sort -u | wc -l)
    echo -e "  ${BOLD}${GREEN}  Total: $total conexiones · $ips IPs únicas (últimas 48h)${NC}"
    echo ""
    read -p "  ⏎ Enter para volver al menú..."
}


# ─── Ver consumo de datos por IP (cuota) ───
ver_consumo() {
    echo -e "${BOLD}${YELLOW}  📊 CONSUMO DE DATOS (cuota por IP)${NC}"
    echo -e "${CYAN}  ─────────────────────────────────────────────${NC}"
    # Cuota actual del config
    local quota dias
    quota=$(python3 -c "import json; print(json.load(open('/etc/ctmanager/websocket/config.json')).get('quota_gb', 0))" 2>/dev/null)
    dias=$(python3 -c "import json; print(json.load(open('/etc/ctmanager/websocket/config.json')).get('quota_dias', 30))" 2>/dev/null)
    echo -e "  ${BOLD}${BLUE}  Cuota configurada: ${ORANGE}${quota:-0} GB${NC} (ventana: ${dias:-30} días)"
    echo -e "  ${CYAN}  ─────────────────────────────────────────────${NC}"
    echo -e "  ${BOLD}  IP               CONSUMIDO      % CUOTA   PROTO"
    echo -e "  ${CYAN}  ─────────────────────────────────────────────${NC}"
    # Top 15 IPs por consumo (últimos 30 días)
    sqlite3 -separator '|' /etc/ctmanager/config/trafico.db \
      "SELECT src_ip, SUM(rx_bytes+tx_bytes) as total, GROUP_CONCAT(DISTINCT protocolo) FROM trafico WHERE fecha >= datetime('now','-${dias:-30} days') GROUP BY src_ip ORDER BY total DESC LIMIT 15;" 2>/dev/null | \
    while IFS='|' read -r ip total protos; do
        local gb pct
        gb=$(python3 -c "print(f'{$total/1073741824:.2f}')" 2>/dev/null)
        if [[ -n "$quota" && "$quota" != "0" ]]; then
            pct=$(python3 -c "print(f'{($total/1073741824)/$quota*100:.1f}')" 2>/dev/null)
        else
            pct="—"
        fi
        printf "  %-17s %6s GB   %6s%%    %s\n" "$ip" "$gb" "$pct" "${protos:0:20}"
    done
    echo -e "  ${CYAN}  ─────────────────────────────────────────────${NC}"
    echo ""
    read -p "  ¿Cambiar la cuota? (s/N): " cq
    if [[ "${cq,,}" == "s" ]]; then
        read -p "  Nuevo límite en GB (0 = sin límite): " nueva
        if [[ "$nueva" =~ ^[0-9.]+$ ]]; then
            python3 -c "
import json
cfg = json.load(open('/etc/ctmanager/websocket/config.json'))
cfg['quota_gb'] = float('$nueva')
json.dump(cfg, open('/etc/ctmanager/websocket/config.json','w'), indent=2)
print('Cuota actualizada a', '$nueva', 'GB')
" 2>/dev/null
            systemctl restart pymanager 2>/dev/null || true
            echo -e "  ${GREEN}✅ Cuota cambiada a ${ORANGE}${nueva} GB${NC}"
        else
            echo -e "  ${RED}  ❌ Número inválido${NC}"
        fi
    fi
    echo ""
    read -p "  ⏎ Enter para volver al menú..."
}

# ─── Ver consumo por UUID VLESS (desde logs del proxy) ───
ver_consumo_vless() {
    echo -e "${BOLD}${YELLOW}  📊 CONSUMO POR UUID VLESS${NC}"
    echo -e "${CYAN}  ───────────────────────────────${NC}"
    # Contar conexiones por UUID desde los logs de pymanager (últimas 24h)
    local tmp=$(mktemp)
    journalctl -u pymanager --since '24 hours ago' --no-pager 2>/dev/null | grep -oE 'uuid=[0-9a-f]{8}' | sort | uniq -c | sort -rn > "$tmp"
    if [ ! -s "$tmp" ]; then
        echo -e "  ${YELLOW}  ⚠️  Sin conexiones VLESS en las últimas 24h${NC}"
    else
        echo -e "  ${BOLD}  CONEXIONES  UUID       USUARIO"
        echo -e "  ${CYAN}  ───────────────────────────────${NC}"
        while read -r n uuid; do
            local user
            uuid_full=$(sqlite3 "$VDB" "SELECT uuid FROM users WHERE uuid LIKE '${uuid}%';" 2>/dev/null | head -1)
            user=$(sqlite3 "$VDB" "SELECT username FROM users WHERE uuid='$uuid_full';" 2>/dev/null)
            [ -z "$user" ] && user="(sin registrar)"
            printf "  %-10s  %s   %s\n" "$n" "$uuid" "$user"
        done < "$tmp"
        echo -e "  ${CYAN}  ───────────────────────────────${NC}"
    fi
    rm -f "$tmp"
    echo ""
    read -p "  ⏎ Enter para volver al menú..."
}

# ─── Eliminar usuario VLESS (solo V2Ray) ───
eliminar_vless() {
    local user uuid
    banner
    echo -e "${BOLD}${RED}  🗑️  ELIMINAR USUARIO VLESS${NC}"
    echo -e "${CYAN}  ────────────────────────${NC}"
    # Listar usuarios VLESS actuales
    echo -e "  ${BOLD}Usuarios VLESS registrados:${NC}"
    echo ""
    sqlite3 -separator ' | ' "$VDB" "SELECT username, substr(uuid,1,8), expires_at, activo FROM users ORDER BY username;" 2>/dev/null | while IFS=' | ' read -r u uu exp act; do
        printf "  ${FUCSIA}%s${NC}  (UUID %s  exp: %s  activo: %s)\n" "$u" "$uu" "$exp" "$act"
    done
    echo ""
    read -p "  👤 Nombre del usuario VLESS a eliminar: " user
    [ -z "$user" ] && return

    # Buscar su UUID en la DB
    uuid=$(sqlite3 "$VDB" "SELECT uuid FROM users WHERE username='$user';" 2>/dev/null)
    if [ -z "$uuid" ]; then
        echo -e "  ${RED}  ❌ Usuario '$user' no encontrado en VLESS${NC}"
        read -p "  ⏎ Enter para continuar..."
        return
    fi

    # 1) Quitar de Xray (si existe el script)
    if [ -x "$UUID_SH" ]; then
        "$UUID_SH" remove "$uuid" 2>/dev/null && "$UUID_SH" reload 2>/dev/null
        echo -e "  ${GREEN}  ✅ UUID quitado de Xray${NC}"
    else
        echo -e "  ${YELLOW}  ⚠️  xray_uuid.sh no existe — UUID no tocado en Xray${NC}"
    fi

    # 2) Borrar de la DB
    sqlite3 "$VDB" "DELETE FROM users WHERE username='$user';" 2>/dev/null
    echo -e "  ${GREEN}  ✅ Quitado de v2ray_users.db${NC}"

    # 3) Borrar del archivo de links (por nombre Ghost-<user>)
    if [ -f "$CFG_DIR/v2ray_links.txt" ]; then
        grep -v "#Ghost-$user" "$CFG_DIR/v2ray_links.txt" > /tmp/links.tmp 2>/dev/null && mv /tmp/links.tmp "$CFG_DIR/v2ray_links.txt"
        echo -e "  ${GREEN}  ✅ Link quitado de v2ray_links.txt${NC}"
    fi

    # 4) Matar sus conexiones activas (reinicia xray ya lo hizo, pero por si acaso)
    pkill -f "$uuid" 2>/dev/null || true
    echo ""
    echo -e "  ${GREEN}  ✅ Usuario VLESS '$user' eliminado — acceso cortado${NC}"
    echo ""
    read -p "  ⏎ Enter para continuar..."
}


# ─── Ver consumo Psiphon por IP ───
ver_consumo_psiphon() {
    echo -e "${BOLD}${YELLOW}  📊 CONSUMO PSIPHON POR IP${NC}"
    echo -e "${CYAN}  ────────────────────────────────${NC}"
    local dias
    dias=$(python3 -c "import json; print(json.load(open('/etc/ctmanager/websocket/config.json')).get('quota_dias', 30))" 2>/dev/null)
    dias=${dias:-30}
    echo -e "  ${BOLD}  IP               CONSUMIDO    CONEXIONES   ÚLTIMA VEZ"
    echo -e "  ${CYAN}  ────────────────────────────────${NC}"
    sqlite3 -separator '|' /etc/ctmanager/config/trafico.db \
      "SELECT src_ip, SUM(rx_bytes+tx_bytes) as total, SUM(conexiones) as conns, MAX(fecha) FROM trafico WHERE protocolo='psiphon' AND fecha >= datetime('now','-${dias} days') GROUP BY src_ip ORDER BY total DESC LIMIT 15;" 2>/dev/null | \
    while IFS='|' read -r ip total conns ult; do
        local gb
        gb=$(python3 -c "print(f'{$total/1073741824:.2f}')" 2>/dev/null)
        printf "  %-17s %6s GB   %8s   %s\n" "$ip" "$gb" "${conns:-0}" "${ult:0:16}"
    done
    echo -e "  ${CYAN}  ────────────────────────────────${NC}"
    echo -e "  ${YELLOW}  ℹ️  Psiphon usa un server entry único — el rastreo es por IP,${NC}"
    echo -e "  ${YELLOW}     no por usuario (no hay UUIDs individuales).${NC}"
    echo ""
    read -p "  ⏎ Enter para volver al menú..."
}


# ─── Editar banner del sshgo (editor guiado) ───
editar_banner() {
    local BANNER="/etc/ctmanager/config/sshgo_banner.txt"
    banner
    echo -e "${BOLD}${YELLOW}  🎨 EDITAR BANNER SSHGO${NC}"
    echo -e "${CYAN}  ──────────────────────────${NC}"
    if [[ ! -f "$BANNER" ]]; then
        echo -e "  ${YELLOW}  ⚠️  sshgo no instalado o sin plantilla${NC}"
        echo -e "  ${YELLOW}  El banner solo aplica si sshgo está activo (opción 1 del instalador)${NC}"
        read -p "  ⏎ Enter para continuar..."
        return
    fi
    echo -e "  ${BOLD}Placeholders (se reemplazan solos):${NC}"
    echo -e "  ${CYAN}  USER  → nombre     EXP → vencimiento   DAYS → días"
    echo -e "  ${CYAN}  TRF   → tráfico    LIMIT → límite      {status} → activo/VENCIDO"
    echo ""
    echo -e "  ${BOLD}Opciones:${NC}"
    echo -e "  ${FUCSIA}1${NC}) ✨ Generar plantilla guiada (marca + idioma + color)"
    echo -e "  ${FUCSIA}2${NC}) ✏️  Editar plantilla a mano (nano)"
    echo -e "  ${FUCSIA}3${NC}) 👁️  Ver ejemplo actual (con datos reales)"
    echo -e "  ${FUCSIA}4${NC}) 🔄 Restaurar plantilla default (EPRO.HC)"
    echo -e "  ${FUCSIA}0${NC}) Volver"
    read -p "  ➤ Opción: " bo
    case "$bo" in
        1)
            local marca idioma color hex_color
            read -p "  🏷️  Marca a mostrar (ej: EPRO.HC, MI-VPN, LA RED): " marca
            marca="${marca:-EPRO.HC}"
            echo -e "  🌐 Idioma de las etiquetas:"
            echo -e "    ${FUCSIA}1${NC}) Español (USUARIO/VENCE/DÍAS/TRÁFICO/LÍMITE/ESTADO)"
            echo -e "    ${FUCSIA}2${NC}) English (USER/EXPIRE/DAYS/TRAFFIC/LIMIT/STATUS)"
            echo -e "    ${FUCSIA}3${NC}) Português (USUÁRIO/VENCE/DIAS/TRÁFEGO/LIMITE/ESTADO)"
            read -p "  ➤ Idioma [1]: " idioma
            idioma="${idioma:-1}"
            echo -e "  🎨 Color del título (naranja=1, verde=2, azul=3, rojo=4, amarillo=5, blanco=6):"
            read -p "  ➤ Color [1]: " color
            color="${color:-1}"
            case "$color" in
                1) hex_color="#ff8c00";;
                2) hex_color="#00ff00";;
                3) hex_color="#00bfff";;
                4) hex_color="#ff0000";;
                5) hex_color="#ffff00";;
                6) hex_color="#ffffff";;
                *) hex_color="#ff8c00";;
            esac
            # Generar plantilla según idioma
            case "$idioma" in
                2)
                    cat > "$BANNER" << BEOF
<span style="background-color: #000000;"><font color="${hex_color}"><b>✅ ${marca} ✅</b></font></span><br/>
<font color='green'><b>👤 USER:</b> USER</font><br/>
<font color='blue'><b>📅 EXPIRE:</b> EXP</font><br/>
<font color='teal'><b>⏳ DAYS:</b> DAYS</font><br/>
<font color='teal'><b>📊 TRAFFIC:</b> TRF GB</font><br/>
<font color='teal'><b>🎯 LIMIT:</b> LIMIT GB</font><br/>
<font color='red'><b>⚡ STATUS:</b> {status}</font>
BEOF
                    ;;
                3)
                    cat > "$BANNER" << BEOF
<span style="background-color: #000000;"><font color="${hex_color}"><b>✅ ${marca} ✅</b></font></span><br/>
<font color='green'><b>👤 USUÁRIO:</b> USER</font><br/>
<font color='blue'><b>📅 VENCE:</b> EXP</font><br/>
<font color='teal'><b>⏳ DIAS:</b> DAYS</font><br/>
<font color='teal'><b>📊 TRÁFEGO:</b> TRF GB</font><br/>
<font color='teal'><b>🎯 LIMITE:</b> LIMIT GB</font><br/>
<font color='red'><b>⚡ ESTADO:</b> {status}</font>
BEOF
                    ;;
                *)
                    cat > "$BANNER" << BEOF
<span style="background-color: #000000;"><font color="${hex_color}"><b>✅ ${marca} ✅</b></font></span><br/>
<font color='green'><b>👤 USUARIO:</b> USER</font><br/>
<font color='blue'><b>📅 VENCE:</b> EXP</font><br/>
<font color='teal'><b>⏳ DÍAS:</b> DAYS</font><br/>
<font color='teal'><b>📊 TRÁFICO:</b> TRF GB</font><br/>
<font color='teal'><b>🎯 LÍMITE:</b> LIMIT GB</font><br/>
<font color='red'><b>⚡ ESTADO:</b> {status}</font>
BEOF
                    ;;
            esac
            systemctl restart sshgo 2>/dev/null || true
            echo -e "  ${GREEN}✅ Plantilla generada: marca '${marca}' | idioma ${idioma} | color ${hex_color}${NC}"
            echo -e "  ${GREEN}   sshgo reiniciado — probá conectando un usuario${NC}"
            ;;
        2)
            nano "$BANNER"
            systemctl restart sshgo 2>/dev/null || true
            echo -e "  ${GREEN}✅ Plantilla guardada + sshgo reiniciado${NC}"
            ;;
        3)
            local demo
            demo=$(sed -e "s/USER/demo_user/g" -e "s/EXP/2026-12-31/" -e "s/DAYS/131/" -e "s/TRF/12.50/" -e "s/LIMIT/50/" -e "s/{status}/activo/" "$BANNER")
            echo -e "  ${BOLD}Así se vería:${NC}"
            echo -e "${CYAN}  ──────────────${NC}"
            echo "$demo"
            echo -e "${CYAN}  ──────────────${NC}"
            ;;
        4)
            cat > "$BANNER" << 'BEOF'
<span style="background-color: #000000;"><font color="#ff8c00"><b>✅ EPRO.HC ✅</b></font></span><br/>
<font color='green'><b>👤 USUARIO:</b> USER</font><br/>
<font color='blue'><b>📅 VENCE:</b> EXP</font><br/>
<font color='teal'><b>⏳ DÍAS:</b> DAYS</font><br/>
<font color='teal'><b>📊 TRÁFICO:</b> TRF GB</font><br/>
<font color='teal'><b>🎯 LÍMITE:</b> LIMIT GB</font><br/>
<font color='red'><b>⚡ ESTADO:</b> {status}</font>
BEOF
            systemctl restart sshgo 2>/dev/null || true
            echo -e "  ${GREEN}✅ Plantilla EPRO.HC restaurada${NC}"
            ;;
        *) return;;
    esac
    echo ""
    read -p "  ⏎ Enter para volver al menú..."
}



