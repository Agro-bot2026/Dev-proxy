    row = conn.execute('SELECT cc FROM geo WHERE start<=? AND end>=? ORDER BY start DESC LIMIT 1', (n, n)).fetchone()
    conn.close()
    print(row[0] if row else '??')
except Exception:
    print('??')
"
}

