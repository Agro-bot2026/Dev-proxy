    echo "$lineas" | sed -E 's/.*::ffff:([0-9.]+) -> [0-9.:]+ \(([A-Za-z ]+)\).*/\1|\2/' | \
        sort | uniq -c | sort -rn | head -20 | while read -r count data; do
            local ip proto
