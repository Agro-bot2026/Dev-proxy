# ─── Crear usuario Psiphon ───
crear_psiphon() {
    banner
    echo -e "${BOLD}${YELLOW}  🌐 PSIPHON${NC}"
    echo -e "${CYAN}  ──────────────${NC}"
    echo -e "  ⚠️  El server Psiphon usa UNA credencial única para todos."
    echo -e "  Para expirar usuarios: regenerá la credencial (kill-switch)."
    echo ""
    if [ -f /etc/psiphon/server-entry.dat ]; then
        echo -e "  ${GREEN}✅ Server Psiphon instalado${NC}"
        echo -e "  📄 Server entry: /etc/psiphon/server-entry.dat"
        SIZE=$(stat -c%s /etc/psiphon/server-entry.dat 2>/dev/null)
        echo -e "  📏 Tamaño: $SIZE bytes"
        if [ -f /etc/psiphon/psiphond.config ]; then
            USER_PSI=$(grep -oE '"SSHUserName"\s*:\s*"[^"]*"' /etc/psiphon/psiphond.config 2>/dev/null | head -1 | cut -d'"' -f4)
            echo -e "  👤 Credencial: ${BOLD}$USER_PSI${NC}"
        fi
        echo ""
        echo -e "  ${BOLD}${GREEN}1${NC}) 📋 Ver el HEX (para importar en HTTP Custom)"
        echo -e "  ${BOLD}${RED}0${NC}) Volver"
        echo ""
        read -p "  ➤ Opción: " psi_op
        if [ "$psi_op" = "1" ]; then
            echo ""
            echo -e "${BOLD}${YELLOW}  📋 SERVER ENTRY HEX (copiá todo esto):${NC}"
            echo -e "${CYAN}  ──────────────────────────────────────────${NC}"
            cat /etc/psiphon/server-entry.dat
            echo ""
            echo -e "${CYAN}  ──────────────────────────────────────────${NC}"
            echo -e "  ${YELLOW}💡 Pegá este HEX en: HTTP Custom → Psiphon → Server Entry${NC}"
        fi
    else
        echo -e "  ${RED}❌ Server Psiphon no instalado${NC}"
        echo -e "  ${YELLOW}💡 Corré el instalador con: bash <(curl -s URL) auto${NC}"
    fi
    echo ""
    read -p "  ⏎ Enter para continuar..."
}

# ─── Listar usuarios ───
listar() {
    banner
    echo -e "${BOLD}${YELLOW}  👥 USUARIOS SSH / OPENVPN${NC}"
    echo -e "${CYAN}  ──────────────────────────${NC}"
    sqlite3 -header -column "$DB" "SELECT username, expires_at, CASE WHEN activo=1 THEN '✅' ELSE '❌' END as activo FROM users ORDER BY expires_at DESC;" 2>/dev/null || echo "  (sin usuarios)"
    echo ""
    echo -e "${BOLD}${YELLOW}  🚀 USUARIOS V2RAY${NC}"
    echo -e "${CYAN}  ────────────────${NC}"
    sqlite3 -header -column "$VDB" "SELECT username, substr(uuid,1,8)||'...' as uuid, expires_at FROM users ORDER BY expires_at DESC;" 2>/dev/null || echo "  (sin usuarios)"
    echo ""
    echo -e "${BOLD}${YELLOW}  📄 CONFIGS EN DISCO (/opt/ghost-configs)${NC}"
    ls /opt/ghost-configs/*.hc 2>/dev/null | wc -l | xargs echo "  🗂️  "
    echo ""
    read -p "  ⏎ Enter para continuar..."
}

# ─── Eliminar usuario ───
eliminar() {
    local user
    banner
    echo -e "${BOLD}${RED}  🗑️  ELIMINAR USUARIO${NC}"
    echo -e "${CYAN}  ────────────────${NC}"
    read -p "  👤 Nombre del usuario a eliminar: " user
    [ -z "$user" ] && return

    # Sistema
    pkill -u "$user" 2>/dev/null || true
    userdel -f "$user" 2>/dev/null && echo -e "  ${GREEN}✅ Usuario de sistema eliminado${NC}" || echo -e "  ${YELLOW}⚠️  No era usuario de sistema${NC}"
    rm -f "/etc/ssh/sshd_config.d/$user.conf"

    # DBs
    sqlite3 "$DB" "DELETE FROM users WHERE username='$user';" 2>/dev/null && echo -e "  ${GREEN}✅ Quitado de ssh_users.db${NC}"
    VUUID=$(sqlite3 "$VDB" "SELECT uuid FROM users WHERE username='$user';" 2>/dev/null)
    if [ -n "$VUUID" ] && [ -x "$UUID_SH" ]; then
        "$UUID_SH" remove "$VUUID" 2>/dev/null && "$UUID_SH" reload 2>/dev/null
        echo -e "  ${GREEN}✅ UUID quitado de Xray${NC}"
    fi
    sqlite3 "$VDB" "DELETE FROM users WHERE username='$user';" 2>/dev/null

    # Configs
    rm -f /opt/ghost-configs/*"$user"*.hc 2>/dev/null
    echo -e "  ${GREEN}✅ Configs del usuario borrados${NC}"
    echo ""
    read -p "  ⏎ Enter para continuar..."
}

# ─── Menú principal ───
# ─── RENOVAR (extender días a un usuario existente) ───
renovar() {
    local user dias nuevaExp
    banner
    echo -e "${BOLD}${YELLOW}  🔄 RENOVAR USUARIO${NC}"
    echo -e "${CYAN}  ────────────────${NC}"
    read -p "  👤 Nombre del usuario: " user
    [ -z "$user" ] && return
    read -p "  ⏳ Agregar cuántos DÍAS: " dias
    dias=${dias:-30}

    # Usuario de sistema (SSH/OVPN/UDP)
    if id "$user" >/dev/null 2>&1; then
        # Extender desde la expiración actual (si ya venció, desde hoy)
        local expActual
        expActual=$(chage -l "$user" 2>/dev/null | grep "Cuenta expira" | awk -F': ' '{print $2}')
        [[ "$expActual" == *"nunca"* || -z "$expActual" ]] && expActual=$(date +%Y-%m-%d)
        # Si ya venció, arrancar desde hoy
        if [[ "$(date -d "$expActual" +%s)" -lt "$(date +%s)" ]]; then
            nuevaExp=$(date -d "+${dias} days" +%Y-%m-%d)
        else
            nuevaExp=$(date -d "$expActual +${dias} days" +%Y-%m-%d)
        fi
        chage -E "$nuevaExp" "$user" 2>/dev/null || true
        echo -e "  ${GREEN}✅ Usuario $user renovado hasta: $nuevaExp${NC}"
    else
        nuevaExp=$(date -d "+${dias} days" +%Y-%m-%d)
        echo -e "  ${YELLOW}⚠️  No es usuario de sistema — igual actualizo DB${NC}"
    fi

    # DB SSH
    if [ -f "$DB" ]; then
        sqlite3 "$DB" "UPDATE users SET expires_at='$nuevaExp 23:59:59' WHERE username='$user';" 2>/dev/null \
            && echo -e "  ${GREEN}✅ ssh_users.db actualizado${NC}"
    fi
    # DB V2Ray
    if [ -f "$VDB" ]; then
        sqlite3 "$VDB" "UPDATE users SET expires_at='$nuevaExp 23:59:59' WHERE username='$user';" 2>/dev/null \
            && echo -e "  ${GREEN}✅ v2ray_users.db actualizado${NC}"
    fi
    # Configs en disco (renovar expiry de los .hc del usuario)
    if ls /opt/ghost-configs/*"$user"*.hc >/dev/null 2>&1; then
        echo -e "  ${YELLOW}⚠️  Los configs .hc en disco conservan su expiry propio." 
        echo -e "     Regeneralos o renovalos por el bot (/renovar).${NC}"
    fi
    echo ""
    read -p "  ⏎ Enter para continuar..."
}

# ─── EDITAR (cambiar password de un usuario) ───
editar() {
    local user pass
    banner
    echo -e "${BOLD}${YELLOW}  ✏️  EDITAR USUARIO (cambiar clave)${NC}"
    echo -e "${CYAN}  ────────────────────────────────${NC}"
    read -p "  👤 Nombre del usuario: " user
    [ -z "$user" ] && return

    if id "$user" >/dev/null 2>&1; then
        pass=$(openssl rand -hex 4)
        echo "$user:$pass" | chpasswd 2>/dev/null
        echo -e "  ${GREEN}✅ Clave nueva de $user: $pass${NC}"
    else
        echo -e "  ${RED}❌ El usuario $user no existe en el sistema${NC}"
    fi
    echo ""
    read -p "  ⏎ Enter para continuar..."
}

# ─── Menú principal ───
menu() {
    while true; do
        banner
        echo -e "${BOLD}${YELLOW}  📋 MENÚ PRINCIPAL${NC}"
        echo -e "${CYAN}  ───────────────${NC}"
        echo -e "  ${BOLD}${CYAN}  👤 USUARIOS${NC}"
        echo -e "  ${BOLD}${GREEN}1${NC}) 📊 Estado del sistema"
        echo -e "  ${BOLD}${GREEN}2${NC}) 👤 Crear usuario SSH/OpenVPN"
        echo -e "  ${BOLD}${GREEN}3${NC}) 🚀 Crear usuario V2Ray"
        echo -e "  ${BOLD}${GREEN}4${NC}) 🛰️  Crear usuario UDP Custom"
        echo -e "  ${BOLD}${GREEN}5${NC}) 👥 Listar usuarios (ver todos)"
        echo -e "  ${BOLD}${GREEN}6${NC}) 🔄 Renovar usuario (agregar más días)"
        echo -e "  ${BOLD}${GREEN}7${NC}) ✏️  Editar usuario (cambiar contraseña)"
        echo -e "  ${BOLD}${RED}8${NC}) 🗑️  Eliminar usuario (cortar acceso)"
        echo -e "  ${BOLD}${CYAN}  🌐 SERVICIOS${NC}"
        echo -e "  ${BOLD}${GREEN}9${NC}) 🌐 Estado Psiphon (server entry)"
        echo -e "  ${BOLD}${GREEN}10${NC}) 🔐 Estado WireGuard"
        echo -e "  ${BOLD}${GREEN}11${NC}) 🌐 Panel web (http://IP:8303)"
        echo -e "  ${BOLD}${RED}0${NC}) Salir"
        echo ""
        read -p "  ➤ Opción: " op
        case "$op" in
            1) estado; read -p "  ⏎ Enter para continuar...";;
            2) crear_ssh;;
            3) crear_v2ray;;
            4) crear_udpcustom;;
            5) listar;;
            6) renovar;;
            7) editar;;
            8) eliminar;;
            9) crear_psiphon;;
            10) estado_wg;;
            11) panel_web;;
            0) echo -e "${GREEN}  👋 Hasta luego!${NC}"; exit 0;;
            *) echo -e "${RED}  ❌ Opción inválida${NC}"; sleep 1;;
        esac
    done
}

# ─── Inicio ───
if [ "$EUID" -ne 0 ] && [ "$USER" != "root" ]; then
    echo "❌ Ejecutar como root"
    exit 1
fi
menu