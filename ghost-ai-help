#!/usr/bin/env bash
# 🦇 Ghost AI Help — mini asistente de ayuda dentro del VPS
# Soporta: router central gratis (9Router/DeepSeek) o API propia del cliente
# (Anthropic / OpenAI / DeepSeek / compatible-OpenAI)
# Config: /etc/ghost-license/ai-config  (lo escribe el instalador)
#   PROVEEDOR=router|anthropic|openai|deepseek|otro
#   API_KEY=...
#   MODELO=...
#   BASE_URL=...  (solo para "otro")
#
# Uso: ghost-ai-help ["pregunta"]
#   con argumento → responde una sola vez
#   sin argumento → modo chat (escribí "salir" para terminar)

# ─── Config por defecto ───
CONFIG_FILE="/etc/ghost-license/ai-config"
KEY_FILE="/etc/ghost-license/ai-router.key"
ROUTER_CENTRAL="${GHOST_AI_URL:-http://157.250.202.243:20128/v1/chat/completions}"
TIMEOUT=30

# Colores
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BLUE=$'\033[0;34m'
FUCSIA=$'\033[1;35m'; ORANGE=$'\033[38;5;208m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'

# ─── Cargar config ───
PROVEEDOR="router"
API_KEY=""
MODELO=""
BASE_URL=""

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE" 2>/dev/null
fi

# Si no hay config o es router, usar la key del router central
if [[ "$PROVEEDOR" == "router" || -z "$PROVEEDOR" ]]; then
  API_KEY=$(cat "$KEY_FILE" 2>/dev/null || echo "")
fi

# ─── Preguntar a la IA según proveedor ───
ask_ai(){
  local question="$1"

  # ── Router central gratis (9Router del dueño) ──
  if [[ "$PROVEEDOR" == "router" || -z "$PROVEEDOR" ]]; then
    if [[ -z "$API_KEY" ]]; then
      echo -e "${RED}  ❌ No hay key de IA configurada.${NC}"
      echo -e "  ${YELLOW}  Pedile al administrador: /etc/ghost-license/ai-router.key${NC}"
      return 1
    fi
    local models=("oc/mimo-v2.5-free" "oc/deepseek-v4-flash-free" "oc/nemotron-3-ultra-free")
    local model resp
    for model in "${models[@]}"; do
      resp=$(curl -s --max-time "$TIMEOUT" "$ROUTER_CENTRAL" \
        -H "Authorization: Bearer $API_KEY" \
        -H "Content-Type: application/json" \
        --data-binary @- <<JSON
{"model":"$model","messages":[{"role":"system","content":"Sos un asistente tecnico experto en VPS, VPN, HTTP Custom, Xray, SSH, OpenVPN, WireGuard y protocolos de tunelizacion. Respondé en español rioplatense, claro y corto, con pasos numerados cuando haga falta. Si la pregunta no es tecnica o es peligrosa, decí que no sabés."},{"role":"user","content":"$question"}],"max_tokens":400}
JSON
)
      local answer
      answer=$(printf '%s' "$resp" | python3 -c "
import json, sys
raw = sys.stdin.read()
if 'data:' in raw:
    raw = raw.split('data:')[0]
try:
    d = json.loads(raw)
    print(d['choices'][0]['message']['content'].strip())
except Exception:
    sys.exit(1)
" 2>/dev/null)
      if [[ -n "$answer" ]]; then
        echo "$answer"
        return 0
      fi
    done
    echo -e "${YELLOW}  ⚠️  La IA está saturada ahora (los 3 modelos libres ocupados).${NC}"
    echo -e "  ${CYAN}  Probá de nuevo en unos minutos. El menú sigue funcionando normal.${NC}"
    return 1
  fi

  # ── API propia del cliente ──
  if [[ -z "$API_KEY" ]]; then
    echo -e "${RED}  ❌ No hay API key configurada (revisá $CONFIG_FILE).${NC}"
    return 1
  fi

  local system_prompt="Sos un asistente tecnico experto en VPS, VPN, HTTP Custom, Xray, SSH, OpenVPN, WireGuard y protocolos de tunelizacion. Respondé en español rioplatense, claro y corto, con pasos numerados cuando haga falta. Si la pregunta no es tecnica o es peligrosa, decí que no sabés."

  case "$PROVEEDOR" in
    anthropic)
      # Anthropic API (formato messages)
      local resp
      resp=$(curl -s --max-time "$TIMEOUT" "https://api.anthropic.com/v1/messages" \
        -H "x-api-key: $API_KEY" \
        -H "anthropic-version: 2023-06-01" \
        -H "Content-Type: application/json" \
        --data-binary @- <<JSON
{"model":"${MODELO:-claude-sonnet-4-20250514}","max_tokens":400,"system":"$system_prompt","messages":[{"role":"user","content":"$question"}]}
JSON
)
      local answer
      answer=$(printf '%s' "$resp" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print(d['content'][0]['text'].strip())
except Exception:
    sys.exit(1)
" 2>/dev/null)
      if [[ -n "$answer" ]]; then
        echo "$answer"
        return 0
      fi
      ;;

    openai)
      # OpenAI API
      local resp
      resp=$(curl -s --max-time "$TIMEOUT" "https://api.openai.com/v1/chat/completions" \
        -H "Authorization: Bearer $API_KEY" \
        -H "Content-Type: application/json" \
        --data-binary @- <<JSON
{"model":"${MODELO:-gpt-4o-mini}","max_tokens":400,"messages":[{"role":"system","content":"$system_prompt"},{"role":"user","content":"$question"}]}
JSON
)
      local answer
      answer=$(printf '%s' "$resp" | python3 -c "
import json, sys
raw = sys.stdin.read()
if 'data:' in raw:
    raw = raw.split('data:')[0]
try:
    d = json.loads(raw)
    print(d['choices'][0]['message']['content'].strip())
except Exception:
    sys.exit(1)
" 2>/dev/null)
      if [[ -n "$answer" ]]; then
        echo "$answer"
        return 0
      fi
      ;;

    deepseek)
      # DeepSeek API (compatible OpenAI)
      local resp
      resp=$(curl -s --max-time "$TIMEOUT" "https://api.deepseek.com/v1/chat/completions" \
        -H "Authorization: Bearer $API_KEY" \
        -H "Content-Type: application/json" \
        --data-binary @- <<JSON
{"model":"${MODELO:-deepseek-v4-flash}","max_tokens":400,"messages":[{"role":"system","content":"$system_prompt"},{"role":"user","content":"$question"}]}
JSON
)
      local answer
      answer=$(printf '%s' "$resp" | python3 -c "
import json, sys
raw = sys.stdin.read()
if 'data:' in raw:
    raw = raw.split('data:')[0]
try:
    d = json.loads(raw)
    print(d['choices'][0]['message']['content'].strip())
except Exception:
    sys.exit(1)
" 2>/dev/null)
      if [[ -n "$answer" ]]; then
        echo "$answer"
        return 0
      fi
      ;;

    otro)
      # Cualquier API compatible OpenAI (custom base_url)
      local resp
      resp=$(curl -s --max-time "$TIMEOUT" "${BASE_URL:-https://api.openai.com/v1}/chat/completions" \
        -H "Authorization: Bearer $API_KEY" \
        -H "Content-Type: application/json" \
        --data-binary @- <<JSON
{"model":"${MODELO:-gpt-4o-mini}","max_tokens":400,"messages":[{"role":"system","content":"$system_prompt"},{"role":"user","content":"$question"}]}
JSON
)
      local answer
      answer=$(printf '%s' "$resp" | python3 -c "
import json, sys
raw = sys.stdin.read()
if 'data:' in raw:
    raw = raw.split('data:')[0]
try:
    d = json.loads(raw)
    print(d['choices'][0]['message']['content'].strip())
except Exception:
    sys.exit(1)
" 2>/dev/null)
      if [[ -n "$answer" ]]; then
        echo "$answer"
        return 0
      fi
      ;;

    *)
      echo -e "${RED}  ❌ Proveedor desconocido: $PROVEEDOR${NC}"
      return 1
      ;;
  esac

  echo -e "${YELLOW}  ⚠️  La API no respondió (revisá la key o el modelo en $CONFIG_FILE).${NC}"
  return 1
}

# ─── Modo chat interactivo ───
chat_loop(){
  echo -e "${BOLD}${ORANGE}  🦇 GHOST AI HELP${NC} — escribí tu duda (o 'salir')"
  echo -e "${CYAN}  ──────────────────────────────────────────────${NC}"
  while true; do
    echo -e ""
    read -r -p "  ${BOLD}${FUCSIA}🤖 Tú${NC} > " pregunta
    [[ -z "$pregunta" ]] && continue
    [[ "${pregunta,,}" == "salir" || "${pregunta,,}" == "exit" || "${pregunta,,}" == "q" ]] && break
    echo -e "  ${BOLD}${BLUE}🧠 IA pensando...${NC}"
    echo -e "  ${BOLD}${GREEN}IA${NC} > $(ask_ai "$pregunta")"
  done
  echo -e "${GREEN}  👋 ¡Suerte con el VPS!${NC}"
}

# ─── Main ───
if [[ -n "$1" ]]; then
  ask_ai "$1"
else
  chat_loop
fi
