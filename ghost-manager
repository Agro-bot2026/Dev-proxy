# ─── Crear usuario V2Ray ───
crear_v2ray() {
    local user uuid dias expDate
    banner
    echo -e "${BOLD}${YELLOW}  🚀 CREAR USUARIO V2RAY${NC}"
    echo -e "${CYAN}  ────────────────────${NC}"
    echo -e "  ${BOLD}El sistema genera el UUID SOLO — el cliente solo importa el link.${NC}"
    echo ""
    read -p "  👤 Nombre (identificador, ej: juan): " user
    [ -z "$user" ] && { echo -e "${RED}  ❌ Nombre vacío${NC}"; sleep 2; return; }
    read -p "  ⏳ ¿Cuántos DÍAS dura? (ej 30 = 1 mes): " dias
    dias=${dias:-30}
    # Generar UUID (fallback: xray → uuidgen → /proc → openssl)
    uuid=""
    if [ -x "$XRAY_BIN" ]; then
        uuid=$("$XRAY_BIN" uuid 2>/dev/null)
    fi
    if [ -z "$uuid" ] && has_cmd uuidgen; then
        uuid=$(uuidgen 2>/dev/null)
    fi
    if [ -z "$uuid" ] && [ -f /proc/sys/kernel/random/uuid ]; then
        uuid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null)
    fi
    if [ -z "$uuid" ] && has_cmd openssl; then
        uuid=$(openssl rand -hex 16 | sed -E 's/(.{8})(.{4})(.{4})(.{4})(.{12})/\1-\2-\3-\4-\5/')
    fi
    [ -z "$uuid" ] && { echo -e "${RED}  ❌ No pude generar UUID (falta xray/uuidgen/openssl)${NC}"; sleep 2; return; }
    expDate=$(date -d "+${dias} days" "+%Y-%m-%d %H:%M:%S")

    # Agregar UUID a Xray (si existe)
    if [ -x "$UUID_SH" ]; then
        "$UUID_SH" add "$uuid" && "$UUID_SH" reload
    else
        echo -e "${YELLOW}  ⚠️  xray_uuid.sh no existe — UUID guardado en DB${NC}"
        echo -e "     (si el VPS no tiene Xray, el link se genera igual)"
    fi

    mkdir -p "$CFG_DIR"
    sqlite3 "$VDB" "CREATE TABLE IF NOT EXISTS users (username TEXT PRIMARY KEY, uuid TEXT, expires_at TEXT, activo INTEGER DEFAULT 1);" 2>/dev/null
    sqlite3 "$VDB" "INSERT OR REPLACE INTO users (username, uuid, expires_at) VALUES ('$user','$uuid','$expDate');" 2>/dev/null

    echo ""
    echo -e "${GREEN}  ✅ ¡USUARIO V2RAY CREADO! Guardá estos datos:${NC}"
    echo -e "${CYAN}  ──────────────────────────────────────${NC}"
    echo -e "  👤 Nombre:  ${BOLD}$user${NC}"
    echo -e "  🚀 UUID:    ${BOLD}$uuid${NC}"
    echo -e "  ⏳ Expira:  ${BOLD}$expDate${NC}  (se corta solo al vencer)"
    echo -e "  🔗 Link:    ${BOLD}vless://$uuid@$(get_domain):80?type=tcp&security=none&encryption=none#Ghost-$user${NC}"
    echo ""
    echo -e "  ${YELLOW}💡 El cliente importa el LINK en HTTP Custom (V2Ray).${NC}"
    echo -e "     Cuando venza, renovalo desde el menú (opción 7).${NC}"
    echo ""
    # Guardar el link en un archivo para no perderlo y poder re-verlo (opción listar)
    mkdir -p "$CFG_DIR"
    echo "vless://$uuid@$(get_domain):80?type=tcp&security=none&encryption=none#Ghost-$user" >> "$CFG_DIR/v2ray_links.txt"
    echo -e "${GREEN}  📁 Link guardado también en: ${CFG_DIR}/v2ray_links.txt${NC}"
    echo ""
    echo -n "  ⏎ Presioná ENTER para volver al menú (copiá el link ahora)..."
    read -r _
}

# ─── Ver config OpenVPN armado (CA + remote + payload listo) ───
ver_ovpn() {
    local user="$1" pass="$2"
    local CA IP_PUB DOM
    CA="$(cat /etc/openvpn/easy-rsa/pki/ca.crt 2>/dev/null)"
    IP_PUB="$(get_ip)"
    DOM="$(get_domain)"
    banner
    echo -e "${BOLD}${YELLOW}  📋 CONFIG OPENVPN (para HTTP Custom)${NC}"
    echo -e "${CYAN}  ──────────────────────────────────────────${NC}"

    # 0) Generar el archivo .ovpn (para descargar con el enlace)
    local OVPN_DIR="/etc/ctmanager/ovpn"
    mkdir -p "$OVPN_DIR"
    cat > "$OVPN_DIR/$user.ovpn" <<EOF
client
dev tun
proto tcp-client
remote ${DOM} 80
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verb 3
auth-user-pass
route ${IP_PUB} 255.255.255.255 net_gateway
route 104.18.22.183 255.255.255.255 net_gateway
route 104.18.23.183 255.255.255.255 net_gateway
tun-mtu 1200
mssfix 1200
cipher none
auth none
<ca>
${CA}
</ca>
EOF
    echo -e "  ${BOLD}${GREEN}0${NC}) 📥 DESCARGAR el .ovpn (importar en HTTP Custom)"
    echo -e "     ${BOLD}${YELLOW}http://${DOM}/ovpn/${user}.ovpn${NC}"
    echo -e "     Abrí ese enlace en el celular y descargalo."
    echo -e "     Después: HTTP Custom → OpenVPN → Importar .ovpn"
    echo -e "     Y pegale el payload de abajo + usuario/password."
    echo ""
    echo -e "  ${BOLD}1) PAYLOAD:${NC}"
    echo ""
    echo -e "  ${BOLD}ACL // HTTP/1.9[lf]Host: emailmarketing.personal.com.ar[lf]Expect: 911-continue[crlf][crlf][split][crlf][crlf]GET- // HTTP/1.1[crlf]Host: ${DOM}[crlf]Connection: Upgrade[crlf] [crlf]Upgrade: websocket[crlf][crlf]${NC}"
    echo ""
    echo -e "  ${BOLD}2) PROXY REMOTO:${NC}  ${DOM}:80"
    echo ""
    echo -e "  ${BOLD}3) EDITOR DE CONFIGURACIÓN (.ovpn) — si preferís copiar a mano:${NC}"
    echo -e "  ${CYAN}──────────────────────────────────────────${NC}"
    cat "$OVPN_DIR/$user.ovpn"
    echo -e "  ${CYAN}──────────────────────────────────────────${NC}"
    echo -e "  ${BOLD}4) USUARIO / PASSWORD:${NC}  ${user} / ${pass}"
    echo ""
    echo -e "  ${YELLOW}💡 El archivo .ovpn también queda guardado en:${NC}"
    echo -e "     $OVPN_DIR/$user.ovpn"
}


