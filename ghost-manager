    echo -e "${BOLD}${YELLOW}  📡 CONEXIONES EN VIVO${NC}"
    echo -e "${CYAN}  ─────────────────────────────────────────────────────────────${NC}"
    local lineas
    lineas=$(journalctl -u pymanager --since "48 hours ago" --no-pager -o cat 2>/dev/null | grep -oE "Tunel ::ffff:[0-9.]+ -> [0-9.:]+ \([A-Za-z ]+\)" || true)
    if [[ -z "$lineas" ]]; then
        echo -e "  ${YELLOW}⚠️  No hay conexiones registradas todavía.${NC}"
        echo -e "  ${CYAN}  Cuando alguien conecte con un config, aparece acá.${NC}"
