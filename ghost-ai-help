#!/usr/bin/env bash
# 🦇 Ghost AI Help — mini asistente de ayuda dentro del VPS
# Consulta DeepSeek V4 Flash GRATIS (via 9Router del dueño) para resolver dudas
# NO ejecuta nada en el VPS: solo responde texto. Si la IA no responde, el menú sigue normal.
#
# Uso: ghost-ai-help ["pregunta"]
#   con argumento → responde una sola vez
#   sin argumento → modo chat (escribí "salir" para terminar)

# ─── Config ───
ROUTER_URL="${GHOST_AI_URL:-http://localhost:20128/v1/chat/completions}"
ROUTER_KEY_FILE="/etc/ghost-license/ai-router.key"
MODELS=("oc/mimo-v2.5-free" "oc/deepseek-v4-flash-free" "oc/nemotron-3-ultra-free")
TIMEOUT=25

# Colores
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BLUE=$'\033[0;34m'
FUCSIA=$'\033[1;35m'; ORANGE=$'\033[38;5;208m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'

# ─── Key del router (la baja el instalador; si no hay, avisar) ───
get_key(){
  if [[ -f "$ROUTER_KEY_FILE" ]]; then
    cat "$ROUTER_KEY_FILE"
  else
    echo ""
  fi
}

# ─── Preguntar a la IA (prueba los 3 modelos en orden) ───
ask_ai(){
  local key question="$1"
  key=$(get_key)
  if [[ -z "$key" ]]; then
    echo -e "${RED}  ❌ No hay key de IA configurada.${NC}"
    echo -e "  ${YELLOW}  Pedile al administrador que configure /etc/ghost-license/ai-router.key${NC}"
    return 1
  fi
  local model resp
  for model in "${MODELS[@]}"; do
    resp=$(curl -s --max-time "$TIMEOUT" "$ROUTER_URL" \
      -H "Authorization: Bearer $key" \
      -H "Content-Type: application/json" \
      --data-binary @- <<JSON
{"model":"$model","messages":[{"role":"system","content":"Sos un asistente tecnico experto en VPS, VPN, HTTP Custom, Xray, SSH, OpenVPN, WireGuard y protocolos de tunelizacion. Respondé en español rioplatense, claro y corto, con pasos numerados cuando haga falta. Si la pregunta no es tecnica o es peligrosa, decí que no sabés."},{"role":"user","content":"$question"}],"max_tokens":400}
JSON
)
    # Extraer la respuesta con python (robusto — corta el streaming "data: [DONE]")
    local answer
    answer=$(printf '%s' "$resp" | python3 -c "
import json, sys
raw = sys.stdin.read()
if 'data:' in raw:
    raw = raw.split('data:')[0]
try:
    d = json.loads(raw)
    print(d['choices'][0]['message']['content'].strip())
except Exception:
    sys.exit(1)
" 2>/dev/null)
    if [[ -n "$answer" ]]; then
      echo "$answer"
      return 0
    fi
  done
  echo -e "${YELLOW}  ⚠️  La IA está saturada ahora (los 3 modelos libres ocupados).${NC}"
  echo -e "  ${CYAN}  Probá de nuevo en unos minutos. El resto del menú sigue funcionando normal.${NC}"
  return 1
}

# ─── Modo chat interactivo ───
chat_loop(){
  echo -e "${BOLD}${ORANGE}  🦇 GHOST AI HELP${NC} — escribí tu duda (o 'salir')"
  echo -e "${CYAN}  ──────────────────────────────────────────────${NC}"
  while true; do
    echo -e ""
    read -r -p "  ${BOLD}${FUCSIA}🤖 Tú${NC} > " pregunta
    [[ -z "$pregunta" ]] && continue
    [[ "${pregunta,,}" == "salir" || "${pregunta,,}" == "exit" || "${pregunta,,}" == "q" ]] && break
    echo -e "  ${BOLD}${BLUE}🧠 IA pensando...${NC}"
    echo -e "  ${BOLD}${GREEN}IA${NC} > $(ask_ai "$pregunta")"
  done
  echo -e "${GREEN}  👋 ¡Suerte con el VPS!${NC}"
}

# ─── Main ───
if [[ -n "$1" ]]; then
  ask_ai "$1"
else
  chat_loop
fi
