#!/usr/bin/env bash
# 🦇 GHOST USER MANAGER - Administrador de usuarios VPN
# Gestiona usuarios de SSH, OpenVPN, V2Ray y Psiphon (proxy WS puerto 80)
# Uso: ghost-manager
# ────────────────────────────────────────────────────────────

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'
MAGENTA='\033[0;35m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

DB="/etc/ctmanager/config/ssh_users.db"
VDB="/etc/ctmanager/config/v2ray_users.db"
CFG_DIR="/etc/ctmanager/config"
XRAY_BIN="/usr/local/bin/xray"
XRAY_CFG="/usr/local/etc/xray/config.json"
UUID_SH="/usr/local/bin/xray_uuid.sh"
API_KEY_FILE="/etc/ghost-license/epro-api.key"

# ─── Banner ───
banner() {
    clear
    echo -e "${CYAN}"
    echo "  ██████╗ ██╗  ██╗ ██████╗ ███████╗████████╗"
    echo " ██╔════╝ ██║  ██║██╔════╝ ██╔════╝╚══██╔══╝"
    echo " ██║  ███╗███████║██║  ███╗███████╗   ██║   "
    echo " ██║   ██║██╔══██║██║   ██║╚════██║   ██║   "
    echo " ╚██████╔╝██║  ██║╚██████╔╝███████║   ██║   "
    echo "  ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝   ╚═╝   "
    echo -e "${NC}"
    echo -e "${BOLD}${BLUE}  🦇 Ghost VPN - Administrador de Usuarios${NC}"
    echo -e "${CYAN}  ──────────────────────────────────────────${NC}"
    echo -e "  ${BOLD}Bienvenido! Acá creás y gestionás los accesos VPN.${NC}"
    echo -e "  Cada usuario recibe una CONTRASEÑA y una FECHA de vencimiento."
    echo -e "  Cuando vence, el acceso se corta solo. Podés renovar cuando quieras."
    echo ""
}

# ─── Utilidades ───
has_cmd(){ command -v "$1" >/dev/null 2>&1; }

# ─── Detectar IP pública ───
get_ip() {
    curl -s --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}'
}

# ─── Dominio enlazado al VPS (para links) — usa el guardado, si no la IP ───
get_domain() {
    if [ -f /etc/ctmanager/websocket/dominio ]; then
        cat /etc/ctmanager/websocket/dominio
    else
        get_ip
    fi
}

# ─── Estado del sistema ───
estado() {
    banner
    echo -e "${BOLD}${YELLOW}  📊 ESTADO DEL SISTEMA${NC}"
    echo -e "${CYAN}  ─────────────────────────${NC}"
    echo -e "  🌐 IP pública:     ${GREEN}$(get_ip)${NC}"
    echo -e "  🟢 Puerto 80:      $(systemctl is-active pymanager 2>/dev/null | sed 's/active/✅ Proxy WS activo/;s/inactive/❌ caído/;s/failed/❌ error/')"
    echo -e "  🛡️  OpenVPN 1194:  $(systemctl is-active openvpn@server 2>/dev/null | sed 's/active/✅ activo/;s/inactive/❌ caído/;s/failed/❌ error/')"
    echo -e "  🚀 Xray 8443:      $(systemctl is-active xray 2>/dev/null | sed 's/active/✅ activo/;s/inactive/❌ caído/;s/failed/❌ error/')"
    echo -e "  🌐 Psiphon 2223:   $(systemctl is-active psiphon 2>/dev/null | sed 's/active/✅ activo/;s/inactive/❌ caído/;s/failed/❌ error/')"
    SSH_COUNT=$(sqlite3 "$DB" "SELECT COUNT(*) FROM users;" 2>/dev/null || echo 0)
    V2_COUNT=$(sqlite3 "$VDB" "SELECT COUNT(*) FROM users;" 2>/dev/null || echo 0)
    echo -e "  👥 Usuarios SSH:   ${GREEN}$SSH_COUNT${NC}   🚀 V2Ray: ${GREEN}$V2_COUNT${NC}"
    echo ""
}

# ─── Crear usuario SSH/OpenVPN ───
crear_ssh() {
    local user pass dias expDate
    banner
    echo -e "${BOLD}${YELLOW}  👤 CREAR USUARIO SSH/OPENVPN${NC}"
    echo -e "${CYAN}  ─────────────────────────────${NC}"
    echo -e "  ${BOLD}Este acceso sirve para SSH y OpenVPN (payload).${NC}"
    echo -e "  El sistema genera la contraseña SOLO — no la tenés que inventar."
    echo ""
    read -p "  👤 Nombre de usuario (ej: juan): " user
    [ -z "$user" ] && { echo -e "${RED}  ❌ Nombre vacío${NC}"; sleep 2; return; }
    read -p "  ⏳ ¿Cuántos DÍAS dura? (ej 30 = 1 mes): " dias
    dias=${dias:-30}
    pass=$(openssl rand -hex 4)
    expDate=$(date -d "+${dias} days" "+%Y-%m-%d %H:%M:%S")

    # Usuario de sistema
    if id "$user" >/dev/null 2>&1; then
        echo -e "${RED}  ❌ El usuario $user ya existe${NC}"; sleep 2; return
    fi
    useradd -m -s /bin/false "$user" 2>/dev/null
    echo "$user:$pass" | chpasswd
    chage -E "$(date -d "+${dias} days" +%Y-%m-%d)" "$user" 2>/dev/null || true
    # maxlogins 1 (1 sola persona)
    mkdir -p /etc/ssh/sshd_config.d
    echo "MaxSessions 1" > "/etc/ssh/sshd_config.d/$user.conf"
    systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true

    # DB
    mkdir -p "$CFG_DIR"
    sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL, password TEXT NOT NULL, created_at TEXT DEFAULT (datetime('now')), expires_at TEXT, activo INTEGER DEFAULT 1);" 2>/dev/null
    sqlite3 "$DB" "INSERT OR REPLACE INTO users (username, password, expires_at) VALUES ('$user','$pass','$expDate');" 2>/dev/null

    echo ""
    echo -e "${GREEN}  ✅ ¡USUARIO CREADO! Guardá estos datos:${NC}"
    echo -e "${CYAN}  ────────────────────────────────────${NC}"
    echo -e "  👤 Usuario:  ${BOLD}$user${NC}"
    echo -e "  🔑 Password: ${BOLD}$pass${NC}"
    echo -e "  ⏳ Expira:   ${BOLD}$expDate${NC}  (se corta solo al vencer)"
    echo -e "  🔌 Host:     $(get_domain):22"
    echo -e ""
    echo -e "  ${YELLOW}💡 Pasale estos datos al cliente. Cuando venza,${NC}"
    echo -e "     renovalo desde el menú (opción 6).${NC}"
    echo ""
    read -p "  ⏎ Enter para continuar..."
}

# ─── Crear usuario V2Ray ───
crear_v2ray() {
    local user uuid dias expDate
    banner
    echo -e "${BOLD}${YELLOW}  🚀 CREAR USUARIO V2RAY${NC}"
    echo -e "${CYAN}  ────────────────────${NC}"
    echo -e "  ${BOLD}El sistema genera el UUID SOLO — el cliente solo importa el link.${NC}"
    echo ""
    read -p "  👤 Nombre (identificador, ej: juan): " user
    [ -z "$user" ] && { echo -e "${RED}  ❌ Nombre vacío${NC}"; sleep 2; return; }
    read -p "  ⏳ ¿Cuántos DÍAS dura? (ej 30 = 1 mes): " dias
    dias=${dias:-30}
    # Generar UUID (fallback: xray → uuidgen → /proc → openssl)
    uuid=""
    if [ -x "$XRAY_BIN" ]; then
        uuid=$("$XRAY_BIN" uuid 2>/dev/null)
    fi
    if [ -z "$uuid" ] && has_cmd uuidgen; then
        uuid=$(uuidgen 2>/dev/null)
    fi
    if [ -z "$uuid" ] && [ -f /proc/sys/kernel/random/uuid ]; then
        uuid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null)
    fi
    if [ -z "$uuid" ] && has_cmd openssl; then
        uuid=$(openssl rand -hex 16 | sed -E 's/(.{8})(.{4})(.{4})(.{4})(.{12})/\1-\2-\3-\4-\5/')
    fi
    [ -z "$uuid" ] && { echo -e "${RED}  ❌ No pude generar UUID (falta xray/uuidgen/openssl)${NC}"; sleep 2; return; }
    expDate=$(date -d "+${dias} days" "+%Y-%m-%d %H:%M:%S")

    # Agregar UUID a Xray (si existe)
    if [ -x "$UUID_SH" ]; then
        "$UUID_SH" add "$uuid" && "$UUID_SH" reload
    else
        echo -e "${YELLOW}  ⚠️  xray_uuid.sh no existe — UUID guardado en DB${NC}"
        echo -e "     (si el VPS no tiene Xray, el link se genera igual)"
    fi

    mkdir -p "$CFG_DIR"
    sqlite3 "$VDB" "CREATE TABLE IF NOT EXISTS users (username TEXT PRIMARY KEY, uuid TEXT, expires_at TEXT, activo INTEGER DEFAULT 1);" 2>/dev/null
    sqlite3 "$VDB" "INSERT OR REPLACE INTO users (username, uuid, expires_at) VALUES ('$user','$uuid','$expDate');" 2>/dev/null

    echo ""
    echo -e "${GREEN}  ✅ ¡USUARIO V2RAY CREADO! Guardá estos datos:${NC}"
    echo -e "${CYAN}  ──────────────────────────────────────${NC}"
    echo -e "  👤 Nombre:  ${BOLD}$user${NC}"
    echo -e "  🚀 UUID:    ${BOLD}$uuid${NC}"
    echo -e "  ⏳ Expira:  ${BOLD}$expDate${NC}  (se corta solo al vencer)"
    echo -e "  🔗 Link:    ${BOLD}vless://$uuid@$(get_domain):80?type=tcp&security=none&encryption=none#Ghost-$user${NC}"
    echo ""
    echo -e "  ${YELLOW}💡 El cliente importa el LINK en HTTP Custom (V2Ray).${NC}"
    echo -e "     Cuando venza, renovalo desde el menú (opción 6).${NC}"
    echo ""
    read -p "  ⏎ Enter para continuar..."
}


# ─── Crear usuario UDP Custom (Claro/Personal) ───
