# ─── Ver conexiones en vivo (desde el journal del proxy + geo completo) ───
GEO_DB="/etc/ghost-monitor/geo_countries.db"

# Instalar/actualizar la base de países (una sola vez, ~3MB)
ensure_geo_db() {
    if [[ ! -f "$GEO_DB" ]]; then
        echo -e "  ${CYAN}  🌍 Descargando base de países (1 vez)...${NC}"
        mkdir -p /etc/ghost-monitor
        curl -sL --max-time 120 -o /tmp/dbip.csv "https://raw.githubusercontent.com/sapics/ip-location-db/main/dbip-country/dbip-country-ipv4.csv" 2>/dev/null
        python3 - <<'EOF'
import sqlite3, ipaddress
conn = sqlite3.connect("/etc/ghost-monitor/geo_countries.db")
conn.execute("DROP TABLE IF EXISTS geo")
conn.execute("CREATE TABLE geo (start INTEGER, end INTEGER, cc TEXT)")
batch = []
try:
    with open("/tmp/dbip.csv") as f:
        for line in f:
            p = line.strip().split(",")
            if len(p) != 3: continue
            try:
                batch.append((int(ipaddress.IPv4Address(p[0])), int(ipaddress.IPv4Address(p[1])), p[2]))
            except Exception: continue
            if len(batch) >= 50000:
                conn.executemany("INSERT INTO geo VALUES (?,?,?)", batch); batch = []
    if batch: conn.executemany("INSERT INTO geo VALUES (?,?,?)", batch)
    conn.commit()
except Exception as e:
    print(f"geo db error: {e}")
conn.close()
EOF
        rm -f /tmp/dbip.csv
        chmod 644 "$GEO_DB"
    fi
}

# País por IP (usa la DB completa, sin internet)
